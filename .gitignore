# ==========================================
# Moto Braking Dynamics - Repository .gitignore
# ==========================================

# ------------------------------------------
# Angular (Client)
# ------------------------------------------
**/node_modules/
.angular/cache
dist/
tmp/
out-tsc/
bazel-out/
.sass-cache/
connect.lock
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# FastAPI & Python (Server / Numerical Engine)
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing, Profiling & Type Checkers
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Local simulation caches and runtime outputs
server/outputs/
server/data/cache/
*.log

# ------------------------------------------
# Secrets & Environment Variables
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# Operating System Artifacts
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# IDE & Editor Settings
# ------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
